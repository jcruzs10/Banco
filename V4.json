  "components": {
    "schemas": {
      "ActivarCuentaRequestDto": {
        "required": [
          "idCuenta",
          "montoDeposito"
        ],
        "type": "object",
        "properties": {
          "idCuenta": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "montoDeposito": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "AsociarTarjetaDebitoDto": {
        "required": [
          "idCuenta"
        ],
        "type": "object",
        "properties": {
          "idCuenta": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "Asociación de una tarjeta de débito a una cuenta existente del cuentahabiente."
      },
      "CrearCuentahabienteDto": {
        "required": [
          "dpi",
          "nit",
          "nombre",
          "apellido",
          "telefono",
          "email",
          "idTipoCuenta"
        ],
        "type": "object",
        "properties": {
          "dpi": {
            "type": "string"
          },
          "nit": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "apellido": {
            "type": "string"
          },
          "telefono": {
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "idTipoCuenta": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "Datos para registrar el perfil de un cuentahabiente (persona natural)."
      },
      "DepositoDto": {
        "required": [
          "idCuenta",
          "monto",
          "referencia"
        ],
        "type": "object",
        "properties": {
          "idCuenta": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "monto": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "referencia": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Abono a una cuenta existente."
      },
      "LoginRequest": {
        "required": [
          "credencial",
          "password"
        ],
        "type": "object",
        "properties": {
          "credencial": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "PagoServicioDto": {
        "required": [
          "numeroTarjeta",
          "pin",
          "tipoServicio",
          "identificador",
          "monto",
          "referenciaCliente"
        ],
        "type": "object",
        "properties": {
          "numeroTarjeta": {
            "type": "string"
          },
          "pin": {
            "type": "string"
          },
          "tipoServicio": {
            "$ref": "#/components/schemas/TipoServicioPublico"
          },
          "identificador": {
            "type": "string"
          },
          "monto": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "referenciaCliente": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Pago de servicios públicos/privados desde la cuenta del cuentahabiente aplicando la regla 95/5."
      },
      "RetiroDto": {
        "required": [
          "idCuenta",
          "monto",
          "referencia"
        ],
        "type": "object",
        "properties": {
          "idCuenta": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "monto": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "referencia": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Retiro de fondos validando disponibilidad de saldo en tiempo real."
      },
      "TipoServicioPublico": {
        "type": "integer",
        "description": "Empresa receptora del pago y tipo de identificador único exigido en la orquestación."
      },
      "TransferirRequestDto": {
        "required": [
          "idCuentaOrigen",
          "idCuentaDestino",
          "monto",
          "descripcion"
        ],
        "type": "object",
        "properties": {
          "idCuentaOrigen": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "idCuentaDestino": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "monto": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "descripcion": {
            "type": "string"
          }
        }
      },
      "ValidacionIdentificadorDto": {
        "required": [
          "tipoServicio",
          "identificador"
        ],
        "type": "object",
        "properties": {
          "tipoServicio": {
            "$ref": "#/components/schemas/TipoServicioPublico"
          },
          "identificador": {
            "type": "string"
          }
        },
        "description": "Entrada para validar un identificador ante la empresa correspondiente sin ejecutar cobro."
      }
    }
  },
